@page "/comics/{ComicId:int}/chapters/{ChapterId:int}"

@using SupergirlShrine.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>@(chapter?.Title ?? "Loading...")</PageTitle>

<div class="reader-page">
<div class="@GetReaderPageClass()">
@if (chapter is null || comic is null)
{
    <p class="status-text">Loading...</p>
}
else
{
    <section class="reader-hero">
        <span class="eyebrow">@comic.Title</span>
        <h1>@chapter.Title</h1>
        <a class="back-link" href="/comics/@ComicId">&larr; Back to issue list</a>
        <div class="reader-controls">
            <button class="mode-toggle" @onclick="ToggleFullscreen">&#9974;
                @(isFullscreen ? " Exit fullscreen" : " Fullscreen mode")
            </button>

            <button class="mode-toggle" @onclick="ToggleViewMode">
                @(viewMode == ViewMode.Scroll ? "Page-by-page view" : "Scroll view")
            </button>
            <button class="nav-btn" disabled="@(previousChapterId is null)" @onclick="GoToPreviousChapter">
                &larr; Previous Issue
            </button>
            <button class="nav-btn" disabled="@(nextChapterId is null)" @onclick="GoToNextChapter">
                Next Issue &rarr;
            </button>
        </div>
    </section>

    @if (viewMode == ViewMode.Scroll)
    {
        <div class="page-scroll">
            @foreach (var comicPage in OrderedPages)
            {
                <figure class="page-frame">
                    <img src="https://pub-3a5753cb329f41e1af6d4aa25e14df10.r2.dev/@comicPage.ImagePath" alt="Page @comicPage.PageNumber" class="page-image" loading="lazy" />
                    <figcaption class="page-caption">Page @comicPage.PageNumber</figcaption>
                </figure>
            }
        </div>
    }
    else
    {
        var current = OrderedPages[currentPageIndex];

        <div class="page-single">
            <figure class="page-frame">
                <img src="https://pub-3a5753cb329f41e1af6d4aa25e14df10.r2.dev/@current.ImagePath" alt="Page @current.PageNumber" class="page-image" loading="lazy" />
            </figure>

            <div class="page-nav">
                <button class="nav-btn" disabled="@(currentPageIndex == 0)" @onclick="PreviousPage">
                    &larr; Previous Page
                </button>
                <span class="page-counter">Page @current.PageNumber of @OrderedPages.Count</span>
                <button class="nav-btn" disabled="@(currentPageIndex == OrderedPages.Count - 1)" @onclick="NextPage">
                    Next Page &rarr;
                </button>
            </div>
        </div>
    }

    <section class="reader-footer">
        <div class="reader-controls">
            <button class="nav-btn" disabled="@(previousChapterId is null)" @onclick="GoToPreviousChapter">
                &larr; Previous Issue
            </button>
            <button class="nav-btn" disabled="@(nextChapterId is null)" @onclick="GoToNextChapter">
                Next Issue &rarr;
            </button>
        </div>
    </section>
}
</div>
</div>
@code {
    private enum ViewMode { Scroll, Page }

    [Parameter]
    public int ComicId { get; set; }

    [Parameter]
    public int ChapterId { get; set; }


    [SupplyParameterFromQuery(Name = "page")]
    public int? StartPage { get; set; }
    private ChapterDetailDto? chapter;
    private ComicDetailDto? comic;
    private ViewMode viewMode = ViewMode.Scroll;
    private int currentPageIndex = 0;
    private bool isFullscreen;

    private int? previousChapterId;
    private int? nextChapterId;

    private List<PageDto> OrderedPages => chapter?.Pages.OrderBy(p => p.PageNumber).ToList() ?? [];

    private string GetReaderPageClass() => isFullscreen ? "reader-page reader-page--fullscreen" : "reader-page";

    protected override async Task OnParametersSetAsync()
{
    var client = HttpClientFactory.CreateClient("ComicApi");

    chapter = await client.GetFromJsonAsync<ChapterDetailDto>($"/api/comics/{ComicId}/chapters/{ChapterId}");
    comic = await client.GetFromJsonAsync<ComicDetailDto>($"/api/comics/{ComicId}");

    if (comic is not null)
    {
        var orderedChapters = comic.Chapters.OrderBy(c => c.Order).ToList();
        var currentIndex = orderedChapters.FindIndex(c => c.Id == ChapterId);

        previousChapterId = currentIndex > 0 ? orderedChapters[currentIndex - 1].Id : null;
        nextChapterId = currentIndex < orderedChapters.Count - 1 ? orderedChapters[currentIndex + 1].Id : null;
    }

    if (chapter is not null)
    {
        var orderedPages = chapter.Pages.OrderBy(p => p.PageNumber).ToList();

        if (StartPage is not null)
        {
            var matchIndex = orderedPages.FindIndex(p => p.PageNumber == StartPage);
            currentPageIndex = matchIndex >= 0 ? matchIndex : 0;
            viewMode = ViewMode.Page;
        }
        else
        {
            currentPageIndex = 0;
        }

        var firstPage = orderedPages.ElementAtOrDefault(currentPageIndex);
        if (firstPage is not null)
        {
            await SaveProgress(firstPage.PageNumber);
        }
    }
}

    private void ToggleViewMode()
    {
        viewMode = viewMode == ViewMode.Scroll ? ViewMode.Page : ViewMode.Scroll;
        currentPageIndex = 0;
    }

    private void ToggleFullscreen()
    {
        isFullscreen = !isFullscreen;
    }

private async Task NextPage()
{
    if (currentPageIndex < OrderedPages.Count - 1)
    {
        currentPageIndex++;
        await SaveProgress(OrderedPages[currentPageIndex].PageNumber);
    }
}

private async Task PreviousPage()
{
    if (currentPageIndex > 0)
    {
        currentPageIndex--;
        await SaveProgress(OrderedPages[currentPageIndex].PageNumber);
    }
}

    private void GoToNextChapter()
    {
        if (nextChapterId is not null)
        {
            Navigation.NavigateTo($"/comics/{ComicId}/chapters/{nextChapterId}");
        }
    }

    private void GoToPreviousChapter()
    {
        if (previousChapterId is not null)
        {
            Navigation.NavigateTo($"/comics/{ComicId}/chapters/{previousChapterId}");
        }
    }
    private async Task SaveProgress(int pageNumber)
    {
        var client = HttpClientFactory.CreateClient("ComicApi");
        await client.PostAsJsonAsync($"/api/comics/{ComicId}/progress", new
        {
            chapterId = ChapterId,
            pageNumber
        });
    }
}