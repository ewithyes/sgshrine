@page "/karchive"
@using SupergirlShrine.Web.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>The Karchive</PageTitle>

<section class="karchive-header">
    <h1>The Karchive</h1>
    <p class="karchive-tagline">Content-wise, heavily under construction. Meant to be a timeline of Supergirl's journey through the decades - needs proper research first. Currently has all Supergirl *solo* runs listed.</p>
</section>

<div class="timeline">
    <div class="timeline-rail"></div>

    @for (int i = 0; i < eras.Count; i++)
    {
        var era = eras[i];
        var ownedComic = comics?.FirstOrDefault(c => c.Title.Contains(era.MatchTitle, StringComparison.OrdinalIgnoreCase));
        var side = i % 2 == 0 ? "left" : "right";

        <div class="timeline-entry timeline-entry--@side">
            <div class="timeline-dot @(ownedComic is not null ? "timeline-dot--owned" : "")"></div>

            <div class="timeline-card @(ownedComic is not null ? "timeline-card--owned" : "timeline-card--ghost")">
                <span class="timeline-year">@era.YearRange</span>
                <h3>@era.Title</h3>
                <p>@era.Description</p>

                @if (ownedComic is not null)
                {
                    <a class="timeline-link" href="/comics/@ownedComic.Id">Read &rarr;</a>
                }
                else
                {
                    <span class="timeline-missing">Not yet catalogued</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private record TimelineEra(string YearRange, string Title, string Description, string MatchTitle);

    private List<ComicSummary>? comics;

    private readonly List<TimelineEra> eras = new()
    {
        new("1959", "The Debut", "Kara Zor-El first appears in Action Comics, introduced by writer Otto Binder and artist Al Plastino as Superman's cousin, arriving on Earth from a surviving fragment of Krypton.", "Action Comics #252"),
        new("1972–1974", "The First Solo Series", "Supergirl headlines her own ongoing title for the first time, following her adventures as a college student balancing life at Stanhope College with her secret identity.", "Supergirl (Volume 1)"),
        new("1982–1984", "The Daring New Adventures", "A new volume launches alongside the Helen Slater feature film, repositioning Kara for a new generation of readers.", "Supergirl (Volume 2)"),
        new("1994-1994", "Post-Crisis Beginnings", "Following the events of Crisis on Infinite Earths, Supergirl is put back into action through numerous trials with Lex Luthor.", "Supergirl (Volume 3)"),
        new("1996–2003", "The Linda Danvers Era", "Writer Peter David reinvents the character entirely, merging Kara's essence with a mortal teenager named Linda Danvers in a run considered one of the character's most acclaimed.", "Supergirl (Volume 4)"),
        new("2005–2011", "The Post-Crisis Return", "Kara Zor-El returns to continuity following Crisis on Infinite Earths, arriving on Earth as a teenager and struggling to find her place beside her famous cousin.", "Supergirl (Volume 5)"),
        new("2011–2015", "The New 52", "DC's universe-wide relaunch reintroduces Kara with a harder, more alien edge, chronicling her early, distrustful years on Earth before she settles into heroism.", "Supergirl (Volume 6)"),
        new("2016", "Being Super", "A standalone story by Mariko Tamaki and Joëlle Jones reimagines Kara's teenage years outside of mainstream continuity, grounding her powers and identity in a coming-of-age story.", "Supergirl: Being Super"),
        new("2016–2017", "Rebirth", "Following DC's Rebirth relaunch, Kara settles into a supporting role within the DEO, balancing her double life as a National City high schooler and a government operative.", "Supergirl (Volume 7)"),
        new("2021–2022", "Woman of Tomorrow", "Tom King, Bilquis Evely, and Matheus Lopes send Kara across the galaxy on a mission of vengeance for a young girl, in a story that became one of the character's most celebrated modern outings.", "Woman of Tomorrow"),
        new("2025", "All In", "As part of DC's line-wide relaunch, Kara returns to an ongoing solo title, continuing her story into a new publishing era.", "Supergirl (Volume 8)"),
    };

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ComicApi");
        comics = await client.GetFromJsonAsync<List<ComicSummary>>("/api/comics");
    }
}