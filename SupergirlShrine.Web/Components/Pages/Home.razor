@page "/"
@using SupergirlShrine.Web.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Supergirl Shrine</PageTitle>

<h1>Supergirl Shrine</h1>

@if (comics is null)
{
    <p>Loading...</p>
}
else if (!comics.Any())
{
    <p>No comics yet.</p>
}
else
{
    
    @foreach (var comic in comics)
    {
        <div style="display: flex; flex-direction: row; gap: 1.5rem; padding: 1rem; scroll-behavior: smooth; -webkit-overflow-scrolling: touch;">
            <div style="display: flex; flex-direction: column; align-items: center; margin: 1rem; text-align: center;">
                 <img src="https://pub-3a5753cb329f41e1af6d4aa25e14df10.r2.dev/@comic.CoverImage" alt="@comic.Title" style="height: 400px; display: block; margin-bottom: 0.5rem;" />
                <a href="/comics/@comic.Id" style="text-decoration: none; color: inherit;">
                <strong>@comic.Title</strong>
                @if (comic.StartYear is not null)
                {
                    <span> (@comic.StartYear)</span>
                }
                </a>
            </div>
        </div>
    }
}

@code {
    private List<ComicSummary>? comics;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ComicApi");
        comics = await client.GetFromJsonAsync<List<ComicSummary>>("/api/comics");
    }
}