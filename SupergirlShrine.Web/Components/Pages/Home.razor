@page "/"
@using SupergirlShrine.Web.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Supergirl Shrine</PageTitle>
<div class="home-layout">
    <div class="home-main">
<section class="kara-intro">
    <div class="kara-portrait">
        <img src="images/kara-portrait.png" alt="Kara Zor-El" />
    </div>
    <div class="kara-text">
        <h2>Kara Zor-El</h2>
        <p>
            The Girl of Steel. Last daughter of Krypton. Maiden of Might.<br />
            Born on Krypton, Kara was rocketed to Earth by her father to<br /> save her life. 
            Despite her struggles, she rises to become one of<br /> the greatest heroes of our time,
            also known as Supergirl - <br />the protector of National City and beyond.
        </p>
        <p class="kara-quote">"Guess it's time to beat up something besides myself. "</p>
    </div>
</section>

<section class="continue-reading">
        <div class="section-header">
            <h2>Continue Reading</h2>
        </div>
@if (continueReading is null)
{
    <p class="status-text">Loading...</p>
}
else if (!continueReading.Any())
{
    <p class="status-text">You haven't started reading any comics yet.</p>
}
else
{
        <div class="comic-grid">
            @foreach (var item in continueReading)
            {
                <a class="comic-card" href="/comics/@item.Id/chapters/@item.ChapterId?page=@item.PageNumber">
                    @if (item.CoverImage is not null)
                    {
                        <div class="cover-wrap">
                            <img src="https://pub-3a5753cb329f41e1af6d4aa25e14df10.r2.dev/@item.CoverImage" alt="@item.Title" />
                        </div>
                    }
                    <div class="comic-meta">
                        <span class="comic-title">@item.Title</span>
                        <span class="comic-year">@item.ChapterTitle · Page @item.PageNumber</span>
                    </div>
                </a>
            }
        </div>
}
 </section>
 </div>
<aside class="ledger-wrapper">
    <img src="/images/karara.png" alt="Kara Zor-El" class="ledger-peek" />
 <div class="archive-ledger">
        @if (stats is not null)
        {
            <h3>Quick Stats</h3>

            <dl class="ledger-stats">
                <div class="ledger-row">
                    <dt>Catalogued Comics</dt>
                    <dd>@stats.TotalComics</dd>
                </div>
                <div class="ledger-row">
                    <dt>Catalogued Issues</dt>
                    <dd>@stats.TotalChapters</dd>
                </div>
                @if (stats.LastVisited is not null)
                {
                    <div class="ledger-row">
                        <dt>Last read on </dt>
                        <dd>@stats.LastVisited.Value.ToLocalTime().ToString("MMM d")</dd>
                    </div>
                }
            </dl>
            <img src="images/Supergirl-Logo.png" alt="Kara Zor-El" class="ledger-portrait" />
        }
    </div>
</aside>
</div>

@code {
    private List<ContinueReadingDto>? continueReading;
    private ArchiveStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ComicApi");
        continueReading = await client.GetFromJsonAsync<List<ContinueReadingDto>>("/api/comics/continue-reading");
        stats = await client.GetFromJsonAsync<ArchiveStats>("/api/comics/stats");

    }

}