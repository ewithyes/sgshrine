@page "/"
@using SupergirlShrine.Web.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Supergirl Shrine</PageTitle>
<section class="kara-intro">
    <div class="kara-portrait">
        <img src="images/kara-portrait.png" alt="Kara Zor-El" />
    </div>
    <div class="kara-text">
        <h2>Kara Zor-El</h2>
        <p>
            Last daughter of Krypton. Sent to protect her infant cousin,
            she arrived decades too late, and grew up in his shadow before
            becoming a hero on her own terms.
        </p>
        <p class="kara-quote">"I'm not the Last Son of Krypton. I'm his cousin."</p>
    </div>
</section>

<div class="collection">
@if (comics is null)
{
    <p class="status-text">Loading...</p>
}
else if (!comics.Any())
{
    <p class="status-text">No comics yet.</p>
}
else
{
    <div class="section-header">
        <h2>Recently Added</h2>
    </div>

    <div class="comic-grid">
        @foreach (var comic in comics)
        {
            <a class="comic-card" href="/comics/@comic.Id">
                @if (comic.CoverImage is not null)
                {
                    <div class="cover-wrap">
                        <img src="https://pub-3a5753cb329f41e1af6d4aa25e14df10.r2.dev/@comic.CoverImage" alt="@comic.Title" />
                    </div>
                }
                <div class="comic-meta">
                    <span class="comic-title">@comic.Title</span>
                    @if (comic.StartYear is not null)
                    {
                        <span class="comic-year">@comic.StartYear</span>
                    }
                </div>
            </a>
        }
    </div>
}
</div>

@code {
    private List<ComicSummary>? comics;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ComicApi");
        comics = await client.GetFromJsonAsync<List<ComicSummary>>("/api/comics");
    }
}