@inherits LayoutComponentBase

<div class="page">
    <header class="site-header">
        <nav class="site-nav">
            
            <a href="/comics" class="nav-link" ActiveClass="nav-link--active">
               <span class="mark">✦</span><span class="nav-text">Placeholder</span></a>
            <a href="/" class="logo-link">
                <img src="images/logo.png" alt="Supergirl Shrine" class="logo" />
            </a>
            <a href="/comics" class="nav-link" ActiveClass="nav-link--active">
               <span class="mark">✦</span><span class="nav-text">All Comics</span></a>
